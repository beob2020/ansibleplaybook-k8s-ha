# RKE2 Server Configuration
# Generated by Ansible

# Basic Configuration
write-kubeconfig-mode: "0644"
cni: "calico"
cluster-cidr: "{{ cluster_cidr }}"
service-cidr: "{{ service_cidr }}"
cluster-dns: "10.43.0.10"
cluster-domain: "{{ cluster_domain }}"

# Network Configuration
advertise-address: "{{ ansible_host }}"
node-ip: "{{ ansible_host }}"
node-external-ip: "{{ ansible_host }}"

# TLS Configuration
tls-san:
  - "{{ ansible_host }}"
  - "{{ hostname }}"
  - "{{ hostname }}.{{ cluster_domain }}"
  - "127.0.0.1"
  - "localhost"

# Node Labels
node-label:
{% for label in node_labels | default([]) %}
  - "{{ label }}"
{% endfor %}

# Node Taints (for master nodes)
node-taint:
  - "CriticalAddonsOnly=true:NoExecute"

# etcd Configuration
etcd-expose-metrics: true
etcd-snapshot-schedule-cron: "0 */12 * * *"
etcd-snapshot-retention: 5
etcd-snapshot-dir: "/var/lib/rancher/rke2/server/db/snapshots"

# Kubelet Configuration
kubelet-arg:
  - "max-pods=110"
  - "eviction-hard=memory.available<100Mi,nodefs.available<10%,nodefs.inodesFree<5%,imagefs.available<15%"
  - "eviction-soft=memory.available<300Mi,nodefs.available<15%"
  - "eviction-soft-grace-period=memory.available=30s,nodefs.available=30s"
  - "eviction-max-pod-grace-period=60"
  - "eviction-pressure-transition-period=30s"

# API Server Configuration
kube-apiserver-arg:
  - "audit-log-maxage=30"
  - "audit-log-maxbackup=10"
  - "audit-log-maxsize=100"
  - "audit-log-path=/var/lib/rancher/rke2/server/logs/audit.log"
  - "event-ttl=24h"
  - "default-not-ready-toleration-seconds=30"
  - "default-unreachable-toleration-seconds=30"

# Controller Manager Configuration
kube-controller-manager-arg:
  - "bind-address=0.0.0.0"
  - "cluster-signing-duration=876000h"
  - "terminated-pod-gc-threshold=10"

# Scheduler Configuration
kube-scheduler-arg:
  - "bind-address=0.0.0.0"

# Security Configuration
profile: "cis-1.23"
selinux: {{ selinux }}
secrets-encryption: true

# Disable unnecessary components
disable:
  - "rke2-ingress-nginx"
  - "rke2-metrics-server"

# System Default Registry (optional)
# system-default-registry: "registry.example.com"

# Private Registry Configuration (optional)
# private-registry: "/etc/rancher/rke2/registries.yaml"
